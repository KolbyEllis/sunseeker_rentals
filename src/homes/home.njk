---
pagination:
  data: homes
  size: 1
  alias: home
  addAllPagesToCollections: true
permalink: "/homes/{{ home.slug }}/"
tags:
  - home
  - sitemap
---

{% extends "layouts/base.html" %}

{% block head %}
  <link rel="stylesheet" href="/assets/css/homes.css">
{% endblock %}

{% block body %}
{% set featuredPhoto = home.photos[0] if home.photos and home.photos.length else "/assets/images/cabinets2.webp" %}

<section class="home-hero">
  <div class="home-hero__media">
    <img
      src="{{ featuredPhoto }}"
      alt="{{ home.address }}"
      width="1200"
      height="800"
      fetchpriority="high"
      decoding="async"
    >
  </div>
  <div class="home-hero__content">
    <p class="home-eyebrow">Managed by SunSeeker Rentals</p>
    <h1 class="home-title">{{ home.address }}</h1>
    {% if home.beds or home.baths or home.sqft %}
      <p class="home-summary">
        {% if home.beds %}{{ home.beds }} bd{% endif %}{% if home.beds and home.baths %}, {% endif %}
        {% if home.baths %}{{ home.baths }} ba{% endif %}{% if (home.beds or home.baths) and home.sqft %}, {% endif %}
        {% if home.sqft %}{{ home.sqft }} Sq. Ft.{% endif %}
      </p>
    {% endif %}
    <p class="home-lead">
      Interested in renting with us? Browse homes that are available right now — availability changes often.
    </p>
    <div class="home-actions">
      <a class="home-button home-button--primary" href="/rentals/">See current available rentals</a>
      <a class="home-button home-button--secondary" href="/contact/">Contact us</a>
    </div>
  </div>
</section>

<section class="home-section">
  <div class="home-container">
    {% if home.marketingTitle %}
      <h2 class="home-section-title">{{ home.marketingTitle }}</h2>
    {% else %}
      <h2 class="home-section-title">About this property</h2>
    {% endif %}

    {% if home.description %}
      <p class="home-description">{{ home.description }}</p>
    {% endif %}

    {% if not home.currentlyPosted %}
      <p class="home-note">
        This property is part of our managed portfolio archive. It may not be available today —
        <a href="/rentals/">view current listings</a> for homes you can apply to now.
      </p>
    {% endif %}
  </div>
</section>

{% if home.photos and home.photos.length > 1 %}
<section class="home-section home-section--gallery">
  <div class="home-container">
    <h2 class="home-section-title">Photos</h2>
    <div class="home-gallery">
      {% for photo in home.photos %}
        <figure class="home-gallery__item">
          <img
            src="{{ photo }}"
            alt="{{ home.address }} photo {{ loop.index }}"
            width="800"
            height="600"
            loading="lazy"
            decoding="async"
          >
        </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if home.petPolicy and home.petPolicy.length %}
<section class="home-section">
  <div class="home-container">
    <h2 class="home-section-title">Pet policy (when last listed)</h2>
    <ul class="home-list">
      {% for item in home.petPolicy %}
        <li>{{ item }}</li>
      {% endfor %}
    </ul>
    <p class="home-note">Policies can change. Confirm details on our current rentals page.</p>
  </div>
</section>
{% endif %}

<section class="home-section home-section--cta">
  <div class="home-container home-cta">
    <h2 class="home-section-title">Looking for a home to rent?</h2>
    <p class="home-lead">Check what’s available now and apply through our secure rental portal.</p>
    <a class="home-button home-button--primary" href="/rentals/">See current available rentals</a>
  </div>
</section>
{% endblock %}
