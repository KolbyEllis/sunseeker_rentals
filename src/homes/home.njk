---
pagination:
  data: homes
  size: 1
  alias: home
  addAllPagesToCollections: true
permalink: "/homes/{{ home.slug }}/"
tags:
  - home
  - sitemap
---

{% extends "layouts/base.html" %}

{% block head %}
  <link rel="stylesheet" href="/assets/css/homes.css">

  {% if listingSchema %}
  <script type="application/ld+json">
  {{ listingSchema | dump | safe }}
  </script>
  {% endif %}
{% endblock %}

{% block body %}
{% set featuredPhoto = home.photos[0] if home.photos and home.photos.length else "/assets/images/cabinets2.webp" %}
{% set allPhotos = home.photos if home.photos and home.photos.length else [featuredPhoto] %}

<section class="home-hero">
  <div class="home-hero__media">
    <button
      type="button"
      class="home-photo-link"
      data-home-gallery-index="0"
      data-home-gallery-src="{{ featuredPhoto }}"
      aria-label="Open photo gallery for {{ home.address }}"
    >
      <img
        src="{{ featuredPhoto }}"
        alt="{{ home.address }}"
        width="1200"
        height="800"
        fetchpriority="high"
        decoding="async"
      >
    </button>
  </div>
  <div class="home-hero__content">
    <p class="home-eyebrow">Managed by <span class="home-eyebrow__brand">SunSeeker Rentals</span></p>
    <h1 class="home-title">{{ home.address }}</h1>
    {% if home.beds or home.baths or home.sqft %}
      <p class="home-summary">
        {% if home.beds %}{{ home.beds }} bd{% endif %}{% if home.beds and home.baths %}, {% endif %}
        {% if home.baths %}{{ home.baths }} ba{% endif %}{% if (home.beds or home.baths) and home.sqft %}, {% endif %}
        {% if home.sqft %}{{ home.sqft }} Sq. Ft.{% endif %}
      </p>
    {% endif %}
    {% if home.currentlyPosted %}
      <p class="home-lead">
        This property is available now.
      </p>
      <div class="home-actions home-actions--available">
        {% if home.applyUrl or home.appfolioId %}
          <a
            class="home-action home-action--apply"
            href="{% if home.applyUrl %}{{ home.applyUrl }}{% else %}https://sunseeker.appfolio.com/listings/rental_applications/new?listable_uid={{ home.appfolioId }}&source=Website{% endif %}"
            target="_blank"
            rel="noopener noreferrer"
          >Apply Now</a>
        {% elif home.appfolioUrl %}
          <a
            class="home-action home-action--apply"
            href="{{ home.appfolioUrl }}"
            target="_blank"
            rel="noopener noreferrer"
          >Apply Now</a>
        {% endif %}
        <a class="home-action home-action--showing" href="/contact/">Set Up a Showing</a>
      </div>
    {% else %}
      <p class="home-lead">
        Interested in renting with us? Browse homes that are available right now. Availability changes often.
      </p>
      <div class="home-actions">
        <a class="home-cta-button" href="/rentals/">See Current Available Rentals</a>
        <a class="home-action home-action--showing" href="/contact/">Set Up a Showing</a>
      </div>
    {% endif %}
  </div>
</section>

<section class="home-section">
  <div class="home-container">
    {% if home.marketingTitle %}
      <h2 class="home-section-title">{{ home.marketingTitle }}</h2>
    {% else %}
      <h2 class="home-section-title">About this property</h2>
    {% endif %}

    {% if home.description %}
      <p class="home-description">{{ home.description }}</p>
    {% endif %}

    {% if home.petPolicy and home.petPolicy.length %}
      <div class="home-pet-policy">
        <h3 class="home-subtitle">Pet policy</h3>
        <ul class="home-list">
          {% for item in home.petPolicy %}
            <li>{{ item }}</li>
          {% endfor %}
        </ul>
        <p class="home-note"><strong>Based on the last listing. Policies can change. Confirm on Current Rentals.</strong></p>
      </div>
    {% endif %}

    {% if not home.currentlyPosted %}
      <p class="home-note">
        This property is part of our managed portfolio archive. It may not be available today.
        <a href="/rentals/">View current listings</a> for homes you can apply to now.
      </p>
    {% endif %}
  </div>
</section>

{% if allPhotos.length > 1 %}
<section class="home-section home-section--gallery">
  <div class="home-container">
    <h2 class="home-section-title">Photos</h2>
    <div class="home-gallery">
      {% for photo in allPhotos %}
        <figure class="home-gallery__item">
          <button
            type="button"
            class="home-photo-link"
            data-home-gallery-index="{{ loop.index0 }}"
            data-home-gallery-src="{{ photo }}"
            aria-label="Open photo {{ loop.index }} of {{ home.address }}"
          >
            <img
              src="{{ photo }}"
              alt="{{ home.address }} photo {{ loop.index }}"
              width="800"
              height="600"
              loading="lazy"
              decoding="async"
            >
          </button>
        </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section id="home-cta" class="home-cta-banner" aria-label="Find available rentals">
  <div class="home-cta-banner__container">
    <div class="home-cta-banner__content">
      <span class="home-cta-banner__topper">SunSeeker Rentals</span>
      <h2 class="home-cta-banner__title">Looking for a home to rent?</h2>
      <p class="home-cta-banner__text">
        See what’s available right now through our rental portal.
      </p>
      <a class="home-cta-button" href="/rentals/">See Current Available Rentals</a>
    </div>
  </div>

  <picture class="home-cta-banner__background" aria-hidden="true">
    <img
      loading="lazy"
      decoding="async"
      src="/assets/images/home-cta-pool.webp"
      alt=""
      width="1920"
      height="660"
    >
  </picture>
</section>

<script src="/assets/js/homes-gallery.js" defer></script>
{% endblock %}
