---
pagination:
  data: rentalCities
  size: 1
  alias: rentalCity
  addAllPagesToCollections: true
permalink: "/houses-for-rent/{{ rentalCity.slug }}/"
tags:
  - sitemap
---

{% extends "layouts/base.html" %}

{% block head %}
  <link rel="stylesheet" href="/assets/css/homes.css">
  {% if itemListSchema %}
  <script type="application/ld+json">
  {{ itemListSchema | dump | safe }}
  </script>
  {% endif %}
{% endblock %}

{% block body %}
<section class="city-rentals">
  <div class="home-container">
    <p class="home-eyebrow">Managed by <span class="home-eyebrow__brand">SunSeeker Rentals</span></p>
    <h1 class="home-title">Houses for Rent in {{ rentalCity.name }}, AZ</h1>
    {% if rentalCity.homes.length %}
    <p class="home-lead">
      These are the houses for rent in {{ rentalCity.name }} right now.
      Open a home to see the rent, photos, and how to apply. Availability changes often.
    </p>

    <ul class="city-rentals__list">
      {% for home in rentalCity.homes %}
        {% set photo = home.photos[0] if home.photos and home.photos.length else "" %}
        <li>
          <a class="city-rentals__card" href="/homes/{{ home.slug }}/">
            {% if photo %}
              <img src="{{ photo }}" alt="" width="640" height="420" loading="lazy" decoding="async">
            {% endif %}
            <span class="city-rentals__body">
              <span class="city-rentals__address">{{ home.address }}</span>
              {% if home.rent %}
                <span class="city-rentals__rent">{{ home.rent }} / month</span>
              {% endif %}
              {% if home.beds or home.baths or home.sqft %}
                <span class="city-rentals__meta">
                  {% if home.beds %}{{ home.beds }} bd{% endif %}{% if home.beds and home.baths %}, {% endif %}
                  {% if home.baths %}{{ home.baths }} ba{% endif %}{% if (home.beds or home.baths) and home.sqft %}, {% endif %}
                  {% if home.sqft %}{{ home.sqft }} sq ft{% endif %}
                </span>
              {% endif %}
            </span>
          </a>
        </li>
      {% endfor %}
    </ul>

    <p class="city-rentals__more">
      <a href="/rentals/">See all current rentals</a>
    </p>
    {% else %}
    <p class="home-lead">
      There are no houses for rent in {{ rentalCity.name }} right now.
      Availability changes often, so check the current rentals for homes you can apply to today.
    </p>
    <p class="city-rentals__more">
      <a href="/rentals/">See current rentals</a>
    </p>
    {% endif %}
  </div>
</section>
{% endblock %}
